# ─── বাধ্যতামূলক ───────────────────────────────────────────────
# PostgreSQL-এর সংযোগ (হোস্টেড ডেটাবেসের ঠিকানা; SSL লাগলে শেষে ?sslmode=require)
# Neon-এ: "Pooled connection" ঠিকানা (হোস্টে -pooler থাকে), শেষে &pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/bcs52?schema=public"
# Migration-এর জন্য সরাসরি সংযোগ (Neon-এ -pooler ছাড়া ঠিকানা); VPS-এ DATABASE_URL-এর মতোই
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/bcs52?schema=public"

# সাইটের পূর্ণ ঠিকানা — ইমেইলের লিংক, sitemap ও নিরাপত্তা-হেডারের জন্য (https দিয়ে)
APP_URL="https://bcs52.example.com"

# অ্যাডমিন প্যানেলে আপলোডের সর্বোচ্চ ফাইল-আকার (MB)। Vercel-এ ৪ (প্ল্যাটফর্মের সীমা ৪.৫); VPS-এ ২৫ পর্যন্ত
NEXT_PUBLIC_MAX_UPLOAD_MB="4"

# ─── ইমেইল (পাসওয়ার্ড রিসেট) — যেকোনো SMTP সেবা ────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="বিসিএস ৫২ প্রস্তুতি <no-reply@example.com>"

# ─── শুধু স্থানীয় পরীক্ষার জন্য ─────────────────────────────────
# প্রোডাকশন বিল্ড স্থানীয় ডেভেলপমেন্ট ডেটাবেসে চালাতে (আসল সার্ভারে দেবেন না)
# ALLOW_LOCAL_DB="1"
