{
  "name": "platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && tsx scripts/deploy-setup.ts && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db": "tsx scripts/db.ts",
    "db:migrate": "prisma migrate dev",
    "db:import": "tsx scripts/import-research.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:verify": "tsx scripts/verify-data.ts",
    "db:studio": "prisma studio",
    "test:progress": "tsx scripts/test-progress.ts",
    "test:level1": "tsx scripts/test-level1.ts",
    "test:level2": "tsx scripts/test-level2.ts",
    "db:allocate": "tsx scripts/allocate-level2.ts --floor 10 --write",
    "test:level3": "tsx scripts/test-level3.ts",
    "backup": "tsx scripts/backup.ts",
    "test:admin": "tsx scripts/test-admin.ts",
    "test": "tsx scripts/run-all-tests.ts",
    "test:security": "tsx scripts/test-security.ts",
    "test:http": "tsx scripts/test-http.ts",
    "test:load": "tsx scripts/test-load.ts",
    "check:integrity": "tsx scripts/check-integrity.ts",
    "postinstall": "prisma generate",
    "setup:prod": "prisma migrate deploy && tsx scripts/import-research.ts && tsx scripts/seed.ts && tsx scripts/allocate-level2.ts --floor 10 --write && tsx scripts/import-current-affairs.ts data/source/current-affairs/current-affairs.docx && tsx scripts/import-current-affairs.ts data/source/current-affairs/bnp-govt-political.docx && tsx scripts/verify-data.ts && tsx scripts/check-integrity.ts"
  },
  "dependencies": {
    "@next/swc-wasm-nodejs": "16.4.5",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "next": "16.4.5",
    "nodemailer": "^7.0.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prisma": "^6.19.3",
    "prisma-json-types-generator": "^3.6.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
